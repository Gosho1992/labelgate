# Copy to .env.local and fill from Firebase console > Project settings > Your apps (web).
# Never commit .env.local or App Check debug tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Local development only (localhost / file:// / the VM): use the App Check DEBUG provider.
# 1 = ask the SDK to print a debug token in the browser console; register it in
# Firebase console > App Check > Apps > Manage debug tokens. Never set this in a production build.
VITE_APPCHECK_DEBUG=
